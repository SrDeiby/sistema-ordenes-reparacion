@model SistemaDeOrdenesDeReparacion.Model.Mecanico

@{
    ViewData["Title"] = "Agregar Mecánico";
}

<style>
    body {
        font-family: 'Segoe UI', sans-serif;
        background: #f5f5f5;
        margin: 0;
        padding: 0;
    }
    .page-container {
        max-width: 600px;
        margin: 40px auto;
        background: #ffffff;
        border-radius: 20px;
        box-shadow: 0 0 15px rgba(0,0,0,0.1);
        overflow: hidden;
    }
    .page-header {
        background: linear-gradient(to right, #1a1a1a, #3d3d3d);
        color: white;
        text-align: center;
        padding: 20px;
    }
    .page-header h1 {
        margin: 0;
        font-size: 24px;
    }
    .page-body {
        padding: 30px;
    }
    .form-group {
        margin-bottom: 20px;
    }
    .form-group label {
        font-weight: 600;
        color: #1a1a1a;
        display: block;
        margin-bottom: 6px;
    }
    .form-control {
        width: 100%;
        padding: 10px 12px;
        border: 1px solid #ccc;
        border-radius: 8px;
        font-size: 1rem;
    }
    .text-danger {
        color: #842029;
        margin-top: 4px;
    }
    .btn-submit {
        background: linear-gradient(45deg, #ff416c, #ff4b2b);
        border: none;
        color: white;
        padding: 12px 24px;
        border-radius: 10px;
        font-weight: bold;
        cursor: pointer;
        transition: opacity 0.3s;
    }
    .btn-submit:hover {
        opacity: .9;
    }
    .btn-back {
        display: inline-block;
        background: linear-gradient(to right, #1e1e1e, #292929);
        color: white;
        padding: 10px 20px;
        border-radius: 10px;
        font-weight: bold;
        text-decoration: none;
        margin-top: 20px;
        transition: opacity 0.3s;
    }
    .btn-back:hover {
        opacity: .85;
    }
</style>

<div class="page-container">
    <div class="page-header">
        <h1>Agregar Mecánico</h1>
    </div>
    <div class="page-body">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="form-group">
                <label asp-for="Identificacion"></label>
                <input asp-for="Identificacion" class="form-control" />
                <span asp-validation-for="Identificacion" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Nombre"></label>
                <input asp-for="Nombre" class="form-control" />
                <span asp-validation-for="Nombre" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Apellidos"></label>
                <input asp-for="Apellidos" class="form-control" />
                <span asp-validation-for="Apellidos" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="CorreoElectronico"></label>
                <input asp-for="CorreoElectronico" class="form-control" />
                <span asp-validation-for="CorreoElectronico" class="text-danger"></span>
            </div>

            <div class="text-center">
                <button type="submit" class="btn-submit">Agregar</button>
            </div>
        </form>

        <div class="text-center">
            <a asp-action="Index" class="btn-back">← Volver a la lista</a>
        </div>
    </div>
</div>

@section Scripts {  
    @Html.Partial("_ValidationScriptsPartial")  
}
