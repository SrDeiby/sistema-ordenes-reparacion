@model SistemaDeOrdenesDeReparacion.Model.Mecanico

@{
    ViewData["Title"] = "VistaMecanico";
}

<style>
    body {
        background-color: white;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        margin: 0;
        padding: 20px;
    }

    .container-mecanico {
        max-width: 900px;
        margin: 0 auto;
        background: linear-gradient(135deg, #ff6b35 0%, #ff4757 50%, #2c2c2c 100%);
        border-radius: 15px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
        overflow: hidden;
    }

    .header-section {
        background: linear-gradient(45deg, #2c2c2c, #1a1a1a);
        color: white;
        padding: 30px;
        text-align: center;
        position: relative;
        overflow: hidden;
    }

        .header-section::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle, rgba(255,107,53,0.1) 0%, transparent 70%);
        }

        .header-section h1 {
            margin: 0;
            font-size: 2.5em;
            font-weight: bold;
            text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.5);
            position: relative;
            z-index: 1;
        }

    .content-section {
        background: white;
        padding: 40px;
        margin: 0;
    }

    .mecanico-title {
        color: #2c2c2c;
        font-size: 1.8em;
        margin-bottom: 20px;
        text-align: center;
        font-weight: bold;
    }

        .mecanico-title::after {
            content: '';
            display: block;
            width: 100px;
            height: 3px;
            background: linear-gradient(to right, #ff6b35, #ff4757);
            margin: 10px auto;
            border-radius: 2px;
        }

    .info-grid {
        display: grid;
        gap: 15px;
        margin-bottom: 30px;
    }

    .info-item {
        background: #f8f9fa;
        border-left: 4px solid #ff6b35;
        padding: 15px;
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .info-item:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 15px rgba(255, 107, 53, 0.2);
        }

    .info-label {
        font-weight: bold;
        color: #2c2c2c;
        font-size: 0.9em;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 5px;
    }

    .info-value {
        color: #ff4757;
        font-size: 1.1em;
        font-weight: 500;
    }

    .actions-section {
        background: linear-gradient(135deg, #2c2c2c 0%, #1a1a1a 100%);
        padding: 30px;
        margin: 0;
    }

    .actions-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 15px;
        margin-bottom: 20px;
        justify-items: stretch; 
    }


    .action-btn {
        background: linear-gradient(45deg, #ff6b35, #ff4757);
        color: white;
        text-decoration: none;
        padding: 15px 20px;
        border-radius: 8px;
        font-weight: bold;
        text-align: center;
        transition: all 0.3s ease;
        border: none;
        cursor: pointer;
        box-shadow: 0 4px 15px rgba(255, 107, 53, 0.3);
        display: block;
    }

        .action-btn:hover {
            background: linear-gradient(45deg, #ff4757, #ff6b35);
            transform: translateY(-3px);
            box-shadow: 0 8px 25px rgba(255, 107, 53, 0.4);
        }

        .action-btn.primary {
            background: linear-gradient(45deg, #ff4757, #c44569);
            font-size: 1.1em;
            padding: 18px 25px;
        }

            .action-btn.primary:hover {
                background: linear-gradient(45deg, #c44569, #ff4757);
            }

    .change-password-btn {
        background: linear-gradient(45deg, #2c2c2c, #1a1a1a);
        border: 2px solid #ff6b35;
        margin-bottom: 20px;
        width: 100%;
    }

        .change-password-btn:hover {
            background: linear-gradient(45deg, #ff6b35, #ff4757);
            border-color: #ff4757;
        }
</style>

<div class="container-mecanico">
    <div class="header-section">
        <h1>Sistema de Mecánico</h1>
    </div>

    <div class="content-section">
        <h2 class="mecanico-title">Bienvenido, @ViewBag.NombreCompleto</h2>

        <div class="info-grid">
            <div class="info-item">
                <div class="info-label">Nombre</div>
                <div class="info-value">@Model.Nombre</div>
            </div>
            <div class="info-item">
                <div class="info-label">Apellidos</div>
                <div class="info-value">@Model.Apellidos</div>
            </div>
            <div class="info-item">
                <div class="info-label">Identificación</div>
                <div class="info-value">@Model.Identificacion</div>
            </div>
            <div class="info-item">
                <div class="info-label">Correo Electrónico</div>
                <div class="info-value">@Model.CorreoElectronico</div>
            </div>
        </div>
    </div>

    <div class="actions-section">
        <a href="@Url.Action("VerificarContrasena", "Mecanico", new { identificacion = Model.Identificacion })"
           class="action-btn change-password-btn">
            Cambiar Contraseña
        </a>

        <div class="actions-grid">
            <a href="/Cliente/Index" class="action-btn">Agregar Cliente</a>
            <a href="/TrabajoMecanico/Index" class="action-btn">Ver Órdenes en Proceso</a>
            <a href="/TrabajoMecanico/OrdenesCanceladas" class="action-btn">Órdenes Canceladas</a>
        </div>

        <a asp-controller="OrdenesDeTrabajo"
           asp-action="Index"
           asp-route-idMecanico="@Model.Id"
           class="action-btn primary">
            Sistema de Agregación de Órdenes de Trabajo
        </a>
    </div>
</div>
