@model SistemaDeOrdenesDeReparacion.Model.VerificarContrasenaViewModel

@{
    ViewData["Title"] = "Verificar Contraseña";
}

<style>
    body {
        font-family: 'Segoe UI', sans-serif;
        background: #f5f5f5;
        margin: 0;
        padding: 0;
    }

    .page-container {
        max-width: 500px;
        margin: 60px auto;
        background: #ffffff;
        border-radius: 20px;
        box-shadow: 0 0 15px rgba(0,0,0,0.1);
        overflow: hidden;
    }

    .page-header {
        background: linear-gradient(to right, #1a1a1a, #3d3d3d);
        color: white;
        text-align: center;
        padding: 20px;
    }

        .page-header h2 {
            margin: 0;
            font-size: 24px;
        }

    .page-body {
        padding: 30px;
    }

    .alert-danger {
        background-color: #f8d7da;
        color: #842029;
        padding: 12px;
        border-radius: 8px;
        margin-bottom: 20px;
        border: none;
    }

    .form-group {
        margin-bottom: 20px;
    }

    .form-label {
        font-weight: 600;
        color: #1a1a1a;
        margin-bottom: 6px;
        display: block;
    }

    .form-control {
        width: 100%;
        padding: 10px 12px;
        border: 1px solid #ccc;
        border-radius: 8px;
        font-size: 1rem;
    }

    .text-danger {
        color: #842029;
        margin-top: 4px;
    }

    .btn-primary {
        background: linear-gradient(to right, #b31217, #e52d27);
        color: white;
        padding: 10px 24px;
        border-radius: 10px;
        font-weight: bold;
        cursor: pointer;
        transition: opacity 0.3s;
    }

        .btn-primary:hover {
            opacity: .9;
        }

    .btn-secondary {
        background: linear-gradient(to right, #1e1e1e, #292929);
        border: none;
        color: white;
        padding: 10px 24px;
        border-radius: 10px;
        font-weight: bold;
        cursor: pointer;
        transition: opacity 0.3s;
    }

        .btn-secondary:hover {
            opacity: .85;
        }

    .button-group {
        display: flex;
        gap: 10px;
        justify-content: flex-end;
        margin-top: 10px;
    }
</style>

<div class="page-container">
    <div class="page-header">
        <h2>Verificar Clave</h2>
    </div>
    <div class="page-body">
        @if (ViewBag.Error != null)
        {
            <div class="alert-danger">@ViewBag.Error</div>
        }
        @using (Html.BeginForm("VerificarContrasena", "Mecanico", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.Id)

            <div class="form-group">
                @Html.LabelFor(m => m.Nombre, new { @class = "form-label" })
                @Html.TextBoxFor(m => m.Nombre, new { @class = "form-control", @readonly = "readonly" })
            </div>

            <div class="form-group">
                @Html.LabelFor(m => m.Contrasena, new { @class = "form-label" })
                @Html.PasswordFor(m => m.Contrasena, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.Contrasena, "", new { @class = "text-danger" })
            </div>

            <div class="button-group">
                <button type="submit" class="btn-primary">Verificar</button>
                <button type="button" class="btn-secondary" onclick="history.back()">Volver</button>
            </div>
        }
    </div>
</div>
