@model SistemaDeOrdenesDeReparacion.Model.Usuario

@{
    ViewData["Title"] = "Cambiar Contraseña";
}

<style>
    body {
        font-family: 'Segoe UI', sans-serif;
        background: #f5f5f5;
        margin: 0;
        padding: 0;
    }

    .page-container {
        max-width: 500px;
        margin: 40px auto;
        background: #ffffff;
        border-radius: 20px;
        box-shadow: 0 0 15px rgba(0,0,0,0.1);
        overflow: hidden;
    }

    .page-header {
        background: linear-gradient(to right, #1a1a1a, #3d3d3d);
        color: white;
        text-align: center;
        padding: 20px;
    }

        .page-header h1 {
            margin: 0;
            font-size: 24px;
        }

    .page-body {
        padding: 30px;
    }

    .form-group {
        margin-bottom: 20px;
    }

        .form-group label {
            font-weight: 600;
            display: block;
            margin-bottom: 6px;
            color: #1a1a1a;
        }

    .form-control {
        width: 100%;
        padding: 10px 12px;
        border: 1px solid #ccc;
        border-radius: 8px;
        font-size: 1rem;
    }

    .alert-danger {
        background-color: #f8d7da;
        color: #842029;
        padding: 12px;
        border-radius: 8px;
        margin-bottom: 20px;
        border: none;
    }

    .btn-primary {
        background: linear-gradient(45deg, #ff416c, #ff4b2b);
        border: none;
        color: white;
        padding: 12px 24px;
        border-radius: 10px;
        font-weight: bold;
        cursor: pointer;
        transition: opacity 0.3s;
    }

        .btn-primary:hover {
            opacity: .9;
        }

    .btn-secondary {
        display: inline-block;
        background: linear-gradient(to right, #1e1e1e, #292929);
        color: white;
        padding: 10px 20px;
        border-radius: 10px;
        font-weight: bold;
        text-decoration: none;
        margin-top: 10px;
        transition: opacity 0.3s;
    }

        .btn-secondary:hover {
            opacity: .85;
        }
</style>

<div class="page-container">
    <div class="page-header">
        <h1>Cambiar Contraseña</h1>
    </div>
    <div class="page-body">
        <form asp-action="CambiarContrasena" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label for="nuevaContrasena1">Nueva Clave</label>
                <input type="password" name="nuevaContrasena1" id="nuevaContrasena1" class="form-control"/>
            </div>

            <div class="form-group">
                <label for="nuevaContrasena2">Confirmar Nueva Clave</label>
                <input type="password" name="nuevaContrasena2" id="nuevaContrasena2" class="form-control"/>
            </div>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger">@ViewBag.Error</div>
            }

            <div class="text-center">
                <button type="submit" class="btn-primary">Guardar Clave</button>
            </div>
        </form>

        <div class="text-center" style="margin-top:20px;">
            <a asp-action="VistaMecanico" class="btn-secondary">Cancelar</a>
        </div>
    </div>
</div>
