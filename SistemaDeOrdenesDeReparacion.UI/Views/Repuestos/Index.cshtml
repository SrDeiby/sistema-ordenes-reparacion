@model IEnumerable<SistemaDeOrdenesDeReparacion.Model.InventarioDeRepuestos>

@{
    ViewData["Title"] = "Gestión de Repuestos";
    var nombreFiltro = Context.Request.Query["nombre"].ToString();
    var filtroActivo = !string.IsNullOrWhiteSpace(nombreFiltro);
}

<style>
    body {
        font-family: 'Segoe UI', sans-serif;
        background-color: #f5f5f5;
        margin: 0;
        padding: 20px;
    }

    .page-container {
        max-width: 1000px;
        margin: 0 auto;
        background: #ffffff;
        border-radius: 20px;
        box-shadow: 0 0 15px rgba(0,0,0,0.1);
        overflow: hidden;
    }

    .page-header {
        background: linear-gradient(45deg, #dc2626, #f97316);
        color: white;
        text-align: center;
        padding: 20px;
    }

        .page-header h1 {
            margin: 0;
            font-size: 1.75rem;
            font-weight: bold;
        }

    .page-body {
        padding: 30px;
    }

    .actions {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-bottom: 20px;
        align-items: center;
        justify-content: space-between;
    }

    .filter-group {
        display: flex;
        gap: 10px;
        align-items: center;
    }

        .filter-group input[type="text"] {
            padding: 8px 12px;
            border: 2px solid #ddd;
            border-radius: 8px;
            font-size: 1rem;
            width: 200px;
        }

        .filter-group input[type="submit"] {
            padding: 8px 16px;
            border: none;
            border-radius: 8px;
            background: linear-gradient(45deg, #dc2626, #f97316);
            color: white;
            font-weight: bold;
            cursor: pointer;
            transition: opacity 0.3s;
        }

            .filter-group input[type="submit"]:hover {
                opacity: .9;
            }

    .btn-create {
        padding: 10px 20px;
        border: none;
        border-radius: 8px;
        background: linear-gradient(45deg, #1e1e1e, #292929);
        color: white;
        font-weight: bold;
        text-decoration: none;
        transition: opacity 0.3s;
    }

        .btn-create:hover {
            opacity: .85;
        }

    .table-responsive {
        overflow-x: auto;
    }

    table.styled-table {
        width: 100%;
        border-collapse: collapse;
    }

        table.styled-table thead {
            background: linear-gradient(45deg, #2c3e50, #34495e);
        }

            table.styled-table thead th {
                color: white;
                padding: 12px;
                text-align: left;
            }

        table.styled-table tbody tr:nth-child(even) {
            background: #f9f9f9;
        }

        table.styled-table tbody td {
            padding: 12px;
            vertical-align: middle;
        }

    .table-actions a {
        color: white;
        background: linear-gradient(45deg, #dc2626, #f97316);
        padding: 6px 12px;
        border-radius: 6px;
        text-decoration: none;
        font-size: 0.9rem;
        transition: opacity 0.3s;
    }

        .table-actions a:hover {
            opacity: .9;
        }

    .back-link {
        display: inline-block;
        margin-top: 20px;
        color: #333;
        text-decoration: none;
        font-weight: bold;
    }
</style>

<div class="page-container">
    <div class="page-header">
        <h1>Gestión de Repuestos</h1>
    </div>

    <div class="page-body">
        <div class="actions">
            <form asp-controller="Repuestos" asp-action="Index" method="get" class="filter-group">
                <label for="nombre">Nombre:</label>
                <input type="text" id="nombre" name="nombre" value="@nombreFiltro" placeholder="Filtrar..." />
                <input type="submit" value="Filtrar" />
                @if (filtroActivo)
                {
                    <a asp-action="Index" class="btn-create">Limpiar</a>
                }
            </form>
            <a asp-action="Create" class="btn-create">Agregar Repuesto</a>
        </div>

        <div class="table-responsive">
            <table class="styled-table">
                <thead>
                    <tr>
                        <th>@Html.DisplayNameFor(m => m.First().Nombre)</th>
                        <th>@Html.DisplayNameFor(m => m.First().Descripcion)</th>
                        <th>@Html.DisplayNameFor(m => m.First().PrecioUnitario)</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Nombre</td>
                            <td>@item.Descripcion</td>
                            <td>₡@item.PrecioUnitario.ToString("N2")</td>
                            <td class="table-actions">
                                <a asp-action="Edit" asp-route-id="@item.Id">Editar</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div>
            @if (!filtroActivo)
            {
                <a href="/Login/VistaAdministrador" class="back-link">← Volver al menú</a>
            }
            else
            {
                <a asp-action="Index" class="back-link">← Volver a la lista</a>
            }
        </div>
    </div>
</div>
