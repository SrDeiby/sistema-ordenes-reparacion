@model SistemaDeOrdenesDeReparacion.Model.Usuario

@{
    ViewData["Title"] = "Cambiar Contraseña";
}

<style>
    .cambiar-container {
        max-width: 500px;
        margin: 2rem auto;
        padding: 2rem;
        background-color: #fff;
        border-radius: 15px;
        box-shadow: 0 0 15px rgba(0, 0, 0, 0.1);
        font-family: 'Segoe UI', sans-serif;
    }

    h1 {
        text-align: center;
        margin-bottom: 1.5rem;
        color: #333;
    }

    .form-group {
        margin-bottom: 1.2rem;
    }

    label {
        display: block;
        margin-bottom: 0.4rem;
        font-weight: bold;
        color: #444;
    }

    input[type="password"] {
        width: 100%;
        padding: 0.5rem;
        font-size: 0.9rem;
        border: 1px solid #ccc;
        border-radius: 8px;
    }

    .alert-danger {
        margin-top: 1rem;
        padding: 0.75rem;
        background-color: #f8d7da;
        border: 1px solid #f5c2c7;
        color: #842029;
        border-radius: 8px;
    }

    .btn-guardar {
        width: 100%;
        padding: 0.6rem;
        background: linear-gradient(90deg, #ff416c, #ff4b2b);
        border: none;
        color: white;
        font-weight: bold;
        border-radius: 10px;
        cursor: pointer;
        font-size: 1rem;
        transition: 0.3s ease;
        margin-bottom: 1rem;
    }

        .btn-guardar:hover {
            opacity: 0.9;
        }

    .btn-cancelar {
        width: 100%;
        padding: 0.6rem;
        background: #e0e0e0;
        border: none;
        color: #333;
        font-weight: bold;
        border-radius: 10px;
        cursor: pointer;
        font-size: 1rem;
        transition: 0.3s ease;
        text-decoration: none;
        display: inline-block;
        text-align: center;
    }

        .btn-cancelar:hover {
            background-color: #d5d5d5;
        }
</style>

<div class="cambiar-container">
    <h1>Cambiar Contraseña</h1>

    <form asp-action="CambiarContrasena" method="post">
        @Html.AntiForgeryToken()

        <div class="form-group">
            <label for="nuevaContrasena1">Nueva Clave</label>
            <input type="password" name="nuevaContrasena1" class="form-control"/>
        </div>

        <div class="form-group">
            <label for="nuevaContrasena2">Confirmar Nueva Clave</label>
            <input type="password" name="nuevaContrasena2" class="form-control" />
        </div>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger">@ViewBag.Error</div>
        }

        <button type="submit" class="btn-guardar">Guardar Clave</button>
    </form>

    <a asp-action="VerificarContrasena" class="btn-cancelar">Cancelar</a>
</div>
