@model SistemaDeOrdenesDeReparacion.Model.VerificarContrasenaViewModel

@{
    ViewData["Title"] = "Verificar Contraseña";
}

<style>
    .verificar-container {
        max-width: 450px;
        margin: 2rem auto;
        padding: 2rem;
        background-color: #ffffff;
        border-radius: 15px;
        box-shadow: 0 0 15px rgba(0, 0, 0, 0.1);
        font-family: 'Segoe UI', sans-serif;
    }

    h2 {
        text-align: center;
        color: #333;
        margin-bottom: 1.5rem;
    }

    label {
        font-weight: bold;
        margin-bottom: 0.4rem;
        display: block;
        color: #444;
    }

    input[type="text"],
    input[type="password"] {
        width: 100%;
        padding: 0.5rem;
        font-size: 0.9rem;
        border: 1px solid #ccc;
        border-radius: 8px;
    }

    .text-danger {
        color: #e74c3c;
        font-size: 0.85rem;
        margin-top: 0.25rem;
    }

    .alert-danger {
        margin-bottom: 1rem;
        padding: 0.75rem;
        background-color: #f8d7da;
        border: 1px solid #f5c2c7;
        color: #842029;
        border-radius: 8px;
    }

    .btn-verificar, .btn-cancelar {
        width: 100%;
        margin-top: 1rem;
        padding: 0.6rem;
        font-weight: bold;
        border: none;
        border-radius: 10px;
        cursor: pointer;
        font-size: 1rem;
        transition: 0.3s ease;
        text-align: center;
        display: block;
        text-decoration: none;
    }

    .btn-verificar {
        background: linear-gradient(90deg, #b31217, #e52d27);
        color: white;
    }

    .btn-cancelar {
        background-color: #e0e0e0;
        color: #333;
    }

        .btn-verificar:hover,
        .btn-cancelar:hover {
            opacity: 0.9;
        }
</style>

<div class="verificar-container">
    <h2>Verificar Contraseña</h2>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">@ViewBag.Error</div>
    }

    @using (Html.BeginForm("VerificarContrasena", "Cliente", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.Id)

        <div class="mb-3">
            @Html.LabelFor(m => m.Nombre)
            @Html.TextBoxFor(m => m.Nombre, new { @readonly = "readonly" })
        </div>

        <div class="mb-3">
            @Html.LabelFor(m => m.Contrasena)
            @Html.PasswordFor(m => m.Contrasena)
            @Html.ValidationMessageFor(m => m.Contrasena, "", new { @class = "text-danger" })
        </div>

        <button type="submit" class="btn-verificar">Verificar</button>
    }

    <a asp-action="VistaCliente" class="btn-cancelar">Cancelar</a>
</div>
