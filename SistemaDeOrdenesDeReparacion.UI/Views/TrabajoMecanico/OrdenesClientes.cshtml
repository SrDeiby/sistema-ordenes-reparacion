@model IEnumerable<SistemaDeOrdenesDeReparacion.Model.OrdenesDeTrabajos>


@{
    ViewData["Title"] = "Órdenes de Trabajo del Cliente";
}

<style>
    body {
        font-family: 'Segoe UI', sans-serif;
        background: #f5f5f5;
        margin: 0;
        padding: 0;
    }

    .page-container {
        max-width: 1100px;
        margin: 40px auto;
        background: #ffffff;
        border-radius: 20px;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
        overflow: hidden;
    }

    .page-header {
        background: linear-gradient(to right, #1f1c2c, #928dab);
        color: white;
        text-align: center;
        padding: 30px;
        border-top-left-radius: 20px;
        border-top-right-radius: 20px;
    }

        .page-header h2 {
            margin: 0;
            font-size: 28px;
            font-weight: bold;
        }

    .page-body {
        padding: 30px;
        background-color: #fafafa;
    }

    .actions {
        margin-bottom: 20px;
        display: flex;
        justify-content: center;
    }

    .btn-back {
        background: linear-gradient(to right, #fc4a1a, #f7b733);
        color: white;
        padding: 12px 24px;
        border-radius: 12px;
        font-weight: 600;
        text-decoration: none;
        transition: 0.3s ease;
    }

        .btn-back:hover {
            opacity: 0.9;
        }

    .table-container {
        overflow-x: auto;
        margin-top: 20px;
    }

    table.styled-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.95rem;
    }

        table.styled-table thead {
            background: linear-gradient(to right, #ff416c, #ff4b2b);
            color: white;
        }

            table.styled-table thead th {
                padding: 14px;
                text-align: left;
            }

        table.styled-table tbody tr:nth-child(even) {
            background: #f9f9f9;
        }

        table.styled-table tbody tr:hover {
            background-color: #fff0f0;
        }

        table.styled-table tbody td {
            padding: 12px;
            color: #333;
            vertical-align: middle;
        }

    .table-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

        .table-actions a {
            padding: 6px 14px;
            border-radius: 10px;
            color: white;
            font-size: 0.85rem;
            font-weight: bold;
            text-decoration: none;
            background: linear-gradient(90deg, #ff416c, #ff4b2b);
            transition: all 0.3s ease;
        }

            .table-actions a:hover {
                opacity: 0.9;
            }
</style>

<div class="page-container">
    <div class="page-header">
        <h2>Órdenes del cliente @ViewBag.NombreCompleto</h2>
    </div>
    <div class="page-body">
        <div class="actions">
            <a asp-controller="Cliente" asp-action="VistaCliente" class="btn-back">← Regresar</a>
        </div>
        <div class="table-container">
            <table class="styled-table">
                <thead>
                    <tr>
                        <th>Estado</th>
                        <th>Tipo de Vehículo</th>
                        <th>Marca</th>
                        <th>Modelo</th>
                        <th>Tipo de Combustión</th>
                        <th>Año de Fabricación</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var orden in Model)
                    {
                        <tr>
                            <td>@orden.Estado.GetDisplayName()</td>
                            <td>@orden.TipoDeVehiculo.GetDisplayName()</td>
                            <td>@orden.Marca</td>
                            <td>@orden.Modelo</td>
                            <td>@orden.TipoDeCombustionInterna</td>
                            <td>@orden.AñoDeFabricacion</td>
                            <td class="table-actions">
                                <a asp-action="Detalle" asp-route-idOrden="@orden.Id">Detalle</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
