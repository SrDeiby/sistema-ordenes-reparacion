@model SistemaDeOrdenesDeReparacion.Model.OrdenesDeTrabajoInventarioDeServicios

@{
    ViewData["Title"] = "Asignar Servicio";
}

<style>
    body {
        font-family: 'Segoe UI', sans-serif;
        background: #f5f5f5;
        margin: 0;
        padding: 0;
    }

    .assign-container {
        max-width: 600px;
        margin: 40px auto;
        background: #ffffff;
        border-radius: 20px;
        box-shadow: 0 0 15px rgba(0,0,0,0.1);
        overflow: hidden;
    }

    .assign-header {
        background: linear-gradient(to right, #1a1a1a, #3d3d3d);
        color: white;
        text-align: center;
        padding: 20px;
    }

        .assign-header h1 {
            margin: 0;
            font-size: 24px;
        }

    .assign-subtitle {
        padding: 0 30px 20px;
        text-align: center;
        color: #333;
    }

        .assign-subtitle h4,
        .assign-subtitle h5 {
            margin: 5px 0;
        }

    .assign-body {
        padding: 30px;
    }

        .assign-body .form-group {
            margin-bottom: 20px;
        }

        .assign-body label {
            font-weight: 600;
        }

    .btn-primary {
        background: linear-gradient(45deg, #ff416c, #ff4b2b);
        border: none;
        color: white;
        padding: 10px 20px;
        border-radius: 10px;
        font-weight: bold;
        transition: opacity 0.3s;
    }

        .btn-primary:hover {
            opacity: .9;
        }

    .btn-secondary {
        background: linear-gradient(to right, #1e1e1e, #292929);
        border: none;
        color: white;
        padding: 10px 20px;
        border-radius: 10px;
        font-weight: bold;
        margin-left: 10px;
        transition: opacity 0.3s;
    }

        .btn-secondary:hover {
            opacity: .85;
        }

    .text-danger {
        color: #842029;
    }
</style>

<div class="assign-container">
    <div class="assign-header">
        <h1>Asignar Servicio</h1>
    </div>

    <div class="assign-subtitle">
        <h4>@ViewBag.NombreServicio</h4>
        <h5>@ViewBag.NombreOrden</h5>
        <hr />
    </div>

    <div class="assign-body">
        <form asp-action="Asignar" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <input type="hidden" asp-for="Id_OrdenesDeTrabajo" />
            <input type="hidden" asp-for="Id_InventarioDeServicios" />

            <div class="form-group">
                <label asp-for="Cantidad"></label>
                <input asp-for="Cantidad" class="form-control" />
                <span asp-validation-for="Cantidad" class="text-danger"></span>
            </div>

            <input asp-for="Total" type="hidden" />

            <div class="form-group mt-4 text-center">
                <button type="submit" class="btn-primary">Asignar</button>
                <a asp-action="Index" class="btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
