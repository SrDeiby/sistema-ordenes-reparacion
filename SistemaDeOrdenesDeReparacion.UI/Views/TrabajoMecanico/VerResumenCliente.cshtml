@{
    ViewData["Title"] = "Resumen de Orden";
}

<style>
    body {
        font-family: 'Segoe UI', sans-serif;
        background: #f5f5f5;
        margin: 0;
        padding: 0;
    }

    .page-container {
        max-width: 600px;
        margin: 40px auto;
        background: #ffffff;
        border-radius: 20px;
        box-shadow: 0 0 15px rgba(0,0,0,0.1);
        overflow: hidden;
    }

    .page-header {
        background: linear-gradient(to right, #1a1a1a, #3d3d3d);
        color: white;
        text-align: center;
        padding: 20px;
    }

        .page-header h2 {
            margin: 0;
            font-size: 24px;
        }

    .page-body {
        padding: 30px;
    }

    .summary-table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 20px;
    }

        .summary-table th {
            text-align: left;
            padding: 12px 0;
            color: #1a1a1a;
            font-weight: 600;
            width: 60%;
        }

        .summary-table td {
            padding: 12px 0;
            color: #333;
        }

    .summary-total td {
        font-size: 1.2rem;
        font-weight: bold;
    }

    .btn-back {
        display: inline-block;
        background: linear-gradient(to right, #1e1e1e, #292929);
        color: white;
        padding: 10px 20px;
        border-radius: 10px;
        font-weight: bold;
        text-decoration: none;
        transition: opacity 0.3s;
    }

        .btn-back:hover {
            opacity: .85;
        }
</style>

<div class="page-container">
    <div class="page-header">
        <h2>Resumen de Orden #@ViewBag.IdOrden</h2>
    </div>
    <div class="page-body">
        <table class="summary-table">
            <tr>
                <th>Total de Repuestos</th>
                <td>₡@((decimal)ViewBag.TotalRepuestos)</td>
            </tr>
            <tr>
                <th>Total de Servicios</th>
                <td>₡@((decimal)ViewBag.TotalServicios)</td>
            </tr>
            <tr class="summary-total">
                <th>Total</th>
                <td>₡@((decimal)ViewBag.Total)</td>
            </tr>
        </table>
        <a asp-action="OrdenesClientes" class="btn-back">← Regresar a la lista de órdenes</a>
    </div>
</div>
